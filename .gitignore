.DS_Store
Thumbs.db
Desktop.ini

# IDE
.idea/
.vscode/
.vs/
*.sln
*.csproj
*.csproj.user
*.sln.iml
*.user

# Temporary files
*.tmp
*.bak
*.swp
*.swo
*.log

# Other
docs/
docs.meta